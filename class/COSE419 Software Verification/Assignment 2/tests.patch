+from click.formatting import HelpFormatter
+
+def test_help_formatter_wrap_boundary_at_min_width_10():
+    # Carefully chosen width so that:
+    # original -> text_width = 10
+    # mutant   -> text_width = 11
+    formatter = HelpFormatter(width=14)
+
+    # First column short → leaves second column near boundary
+    formatter.write_dl([("a", "abcdefghijk")])  # 11 chars
+
+    output = formatter.getvalue().splitlines()
+
+    # Original (width=10): wraps → second line exists
+    # Mutant   (width=11): fits → stays on one line
+    assert len(output) > 1
